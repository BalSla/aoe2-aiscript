{
	"compilerOptions": {
		"target": "es6",
		"module": "commonjs",
		"moduleResolution": "node",
		"sourceMap": true,
		"outDir": "out",
		"resolveJsonModule": true,
		"rootDir": "src",
		"lib": ["es6"],
		"types": ["node"]
	},
	"include": [
		"src"
	],
	"exclude": ["node_modules", ".vscode-test"]
}
